# ---- Vapi (optional shared secret) ----
# If set, Vapi must send this value in an `x-vapi-secret` header. Leave blank to skip auth.
VAPI_WEBHOOK_SECRET=

# ---- Airtable ----
# Personal Access Token from https://airtable.com/create/tokens
# Scopes needed by the running service: data.records:write
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_TABLE=Assessments

# ---- Assessment Builder (HyperAgent) webhook ----
ASSESSMENT_BUILDER_URL=
ASSESSMENT_BUILDER_TOKEN=
# HyperAgent sends the secret in this custom header (not Bearer auth)
ASSESSMENT_BUILDER_AUTH_HEADER=X-Hyperagent-Webhook-Secret
# HyperAgent receives any JSON as the user message; we send intake under this key
ASSESSMENT_BUILDER_BODY_KEY=message

# ---- Telegram notification ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
