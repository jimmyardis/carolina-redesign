# ---- Vapi (optional shared secret) ----
# If set, Vapi must send this value in an `x-vapi-secret` header. Leave blank to skip auth.
VAPI_WEBHOOK_SECRET=

# ---- Airtable (also the report queue read by /build-assessment locally) ----
# Personal Access Token from https://airtable.com/create/tokens
# Scopes needed: data.records:write (webhook) + data.records:read (fetch_intakes.py)
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_TABLE=Assessments

# ---- Telegram notification ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
